# 复制成 .env 后按需修改；docker compose 会自动读取同目录的 .env
#
#   cp .env.example .env

# 宿主机监听地址与端口
# 改成 0.0.0.0 表示局域网可访问 —— 服务没有鉴权，只在可信网络里这么做
WM_BIND=127.0.0.1
WM_PORT=8770

# 单文件上限（字节，默认 256MB）
WATERMARKS_MAX_INPUT_BYTES=268435456
# 一次批量最多多少个文件
WATERMARKS_MAX_BATCH_FILES=50
# 同时清理几个（每个在 /tmp 上占约 3.3–3.7 倍文件大小，别开太大）
WATERMARKS_WEB_CONCURRENCY=2
# 转发到引擎的超时（秒）
WATERMARKS_WEB_TIMEOUT=1800

# 引擎自身鉴权，留空 = 不鉴权
WATERMARKS_SERVER_API_KEY=
